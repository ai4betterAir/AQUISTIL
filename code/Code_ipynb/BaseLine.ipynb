import os
import pandas as pd

# Define the directory paths
input_directory = '/home/ahmedmas/Projects/PurpleAir/Data/AQMS_Data/Processed_AQMS_Data'
output_directory = '/home/ahmedmas/Projects/PurpleAir/Data/AQMS_Data/Processed_AQMS_Data/Baseline_AQMS_Data'

# Create the output directory if it doesn't exist
os.makedirs(output_directory, exist_ok=True)

# List all files in the directory
files = [f for f in os.listdir(input_directory) if f.endswith('.csv')]

# Function to extract site names from column names
def extract_site_names(column_names):
    site_names = []
    for name in column_names:
        if '_' in name:
            site_name = '_'.join(name.split('_')[1:])  # Ensure that everything after the first underscore is the site name
            if site_name not in site_names:
                site_names.append(site_name)
    return site_names

# Function to extract variables from column names
def extract_variables(column_names):
    variables = []
    for name in column_names:
        if '_' in name:
            variable = name.split('_')[0]
            if variable not in variables:
                variables.append(variable)
    return variables

# Function to process each site file
def process_site_file(file_path, site_name):
    # Read the site CSV file
    site_df = pd.read_csv(file_path)

    # Ensure datetime column is in datetime format
    site_df['datetime'] = pd.to_datetime(site_df['datetime'])

    # Set datetime as index to handle interpolation correctly
    site_df = site_df.set_index('datetime')

    # Generate a complete datetime range
    full_datetime_range = pd.date_range(start=site_df.index.min(), end=site_df.index.max(), freq='H')
    site_df = site_df.reindex(full_datetime_range)

    # Interpolate missing values
    site_df = site_df.interpolate(method='linear')

    # Reset index and drop rows with missing values
    site_df = site_df.reset_index().rename(columns={'index': 'datetime'})
    
    # Collect columns related to the current site
    site_columns = ['datetime'] + [col for col in site_df.columns if col.endswith(f'_{site_name}')]

    # Filter to keep only relevant columns
    site_df = site_df[site_columns]

    # Ensure the site data is complete by dropping rows with any NaNs
    site_df = site_df.dropna()

    # Extract date and hour components
    site_df['Date'] = site_df['datetime'].dt.date
    site_df['HourOfDay'] = site_df['datetime'].dt.hour

    # Filter for days with full 24-hour data
    hourly_count = site_df.groupby('Date')['HourOfDay'].nunique()
    full_days = hourly_count[hourly_count == 24].index
    site_df = site_df[site_df['Date'].isin(full_days)]

    # Calculate daily totals for each variable
    for variable in extract_variables(site_df.columns):
        site_df[f'Daily_Total_{variable}_{site_name}'] = site_df.groupby('Date')[f'{variable}_{site_name}'].transform('sum')

        # Calculate hourly proportion of each variable to daily total
        site_df[f'Hourly_Proportion_{variable}_{site_name}'] = site_df[f'{variable}_{site_name}'] / site_df[f'Daily_Total_{variable}_{site_name}']

        # Calculate the average Hourly_Proportion for each HourOfDay
        average_hourly_proportion = site_df.groupby('HourOfDay')[f'Hourly_Proportion_{variable}_{site_name}'].mean().reset_index()

        # Merge the average hourly proportion back to the original dataframe
        site_df = site_df.merge(average_hourly_proportion, on='HourOfDay', suffixes=('', '_Average'))

        # Calculate the new baseline using Hourly_Proportion_Average and daily totals
        site_df[f'Baseline_{variable}_{site_name}'] = site_df[f'Hourly_Proportion_{variable}_{site_name}_Average'] * site_df[f'Daily_Total_{variable}_{site_name}']

    # Keep only the original and baseline columns
    baseline_columns = [col for col in site_df.columns if col.startswith('Baseline_')]
    final_columns = site_columns + baseline_columns
    site_df = site_df[final_columns]

    # Set datetime back as index and sort
    site_df = site_df.set_index('datetime').sort_index()

    # Save the results
    output_file_path = os.path.join(output_directory, f'baseline_all_{site_name}.csv')
    site_df.to_csv(output_file_path, index=True)

    print(f"Baseline and hourly proportion data for all variables at {site_name} station saved successfully at {output_file_path}.")

# Process each file
for file in files:
    filepath = os.path.join(input_directory, file)
    df = pd.read_csv(filepath)
    
    # Extract site names
    site_names = extract_site_names(df.columns)

    for site in site_names:
        # Process the site file for all variables
        process_site_file(filepath, site)
